# {{ ansible_managed }}：來源 mac-bootstrap roles/mac_node/templates/env.zsh.j2
# 改這裡沒用，改 repo 再 make install TAGS=profile。
#
# 由 ~/.zshenv 與 ~/.zprofile 各 source 一次（理由見 roles/mac_node/tasks/profile.yml）。
# 每個 zsh 都會讀：不要有輸出、不要開子程序。
typeset -U path
{% if _have[mac_node_brew] %}

# Homebrew（`brew shellenv` 的靜態等價內容）
export HOMEBREW_PREFIX={{ mac_node_brew_prefix }}
export HOMEBREW_CELLAR={{ mac_node_brew_prefix }}/Cellar
export HOMEBREW_REPOSITORY={{ mac_node_brew_prefix }}
# 排在 /bin 前面：TAGS=bash 的 bash 5 靠這個順序蓋過 /bin/bash 3.2（#!/usr/bin/env bash）
path=({{ mac_node_brew_prefix }}/bin {{ mac_node_brew_prefix }}/sbin $path)
[[ -z "${MANPATH-}" ]] || export MANPATH=":${MANPATH#:}"
export INFOPATH="{{ mac_node_brew_prefix }}/share/info:${INFOPATH:-}"
{% endif %}
{% if _have[mac_node_brew_prefix ~ '/opt/make/libexec/gnubin'] %}

# GNU make 4.x 排在 /usr/bin/make（3.81）前面：mac-bootstrap 的 Makefile 需要 .ONESHELL
path=({{ mac_node_brew_prefix }}/opt/make/libexec/gnubin $path)
{% endif %}
{% if _have[mac_node_brew_prefix ~ '/bin/go'] %}

# Go：go install 裝的東西（GOBIN 預設 ~/go/bin）
path=("$HOME/go/bin" $path)
{% endif %}
{% if _have[mac_node_home ~ '/.cargo/bin'] %}

# Rust：rustup 的 proxy（cargo、rustc…）
path=("$HOME/.cargo/bin" $path)
{% endif %}
{% if _have[mac_node_home ~ '/.local/node/bin'] %}

# Node（官方 tarball，~/.local/node → node-<版本>）
path=("$HOME/.local/node/bin" $path)
{% endif %}
{% if _have[mac_node_home ~ '/.local/bin'] %}

# ~/.local/bin：Claude Code CLI
path=("$HOME/.local/bin" $path)
{% endif %}
{% if _have[mac_node_brew_prefix ~ '/bin/uv'] %}

# uv：不在 ~/.local/bin 放 python3.X 連結，Python 一律 uv run（research §7-7）
export UV_PYTHON_INSTALL_BIN=0
{% endif %}
{% if _podman_socket | default('') %}

# podman machine 的 API socket（沒有 /var/run/docker.sock）。machine 沒啟動時連不上是正常的。
export DOCKER_HOST="unix://{{ _podman_socket }}"
{% endif %}
