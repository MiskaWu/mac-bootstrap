<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- {{ ansible_managed }}。來源：mac-bootstrap（TAGS=gha-runner）。 -->
<plist version="1.0">
<dict>
  <key>Label</key><string>{{ gha_runner_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-l</string><string>-c</string>
    <string>{{ mac_node_home }}/bin/gha-runner-keepalive.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>{{ claude_rc_log_dir }}/gha-runner.log</string>
  <key>StandardErrorPath</key><string>{{ claude_rc_log_dir }}/gha-runner.err.log</string>
</dict>
</plist>
